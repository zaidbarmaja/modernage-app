rules_version = '2';

// ===============================================================
//  قواعد أمان موحّدة — مشروع mohmeed-kadim المشترك بين:
//   • تطبيق Flutter (عصر الحداثة): users, projects, sites, attendance,
//     daily_reports, receipts, employees, customers, customerTransactions ...
//   • تطبيق الويب (modage): customers, departments, customerTransactions,
//     companyTransactions, auditLog.
//
//  النموذج: مدير واحد مُتحكَّم به من الكود (lib/core/app_login.dart) يدخل عبر
//  Firebase Auth. يُسمح لأي مستخدم مسجّل بالقراءة/الكتابة على كل المجموعات،
//  عدا سجل التغييرات auditLog (إنشاء فقط — غير قابل للتعديل أو الحذف).
//  غير المسجّلين: لا قراءة ولا كتابة.
// ===============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // قراءة أي مستند للمستخدم المسجّل.
    match /{document=**} {
      allow read: if signedIn();
    }

    // سجل التغييرات (تطبيق الويب): إنشاء فقط — يبقى غير قابل للتعديل أو الحذف.
    match /auditLog/{id} {
      allow create: if signedIn();
    }

    // الكتابة على أي مجموعة (عدا auditLog) للمستخدم المسجّل.
    match /{col}/{docId} {
      allow write: if signedIn() && col != 'auditLog';
    }
  }
}
